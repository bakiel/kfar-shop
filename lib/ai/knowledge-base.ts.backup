// lib/ai/knowledge-base.ts
import { createRetriever } from 'ai';
import { embedMany, embed } from 'ai';
import { aiModels } from './vercel-ai-integration';

// Knowledge base types
export interface KnowledgeDocument {
  id: string;
  type: 'product' | 'vendor' | 'policy' | 'faq' | 'community' | 'recipe' | 'general';
  title: string;
  content: string;
  metadata: Record<string, any>;
  embedding?: number[];
  lastUpdated: Date;
}

export class KFARKnowledgeBase {
  private documents: Map<string, KnowledgeDocument> = new Map();
  private embeddings: Map<string, number[]> = new Map();
  private initialized = false;

  // Initialize knowledge base with all site information
  async initialize() {
    if (this.initialized) return;

    console.log('🧠 Initializing KFAR Knowledge Base...');

    // Load all knowledge sources
    await Promise.all([
      this.loadProductKnowledge(),
      this.loadVendorKnowledge(),
      this.loadCommunityKnowledge(),
      this.loadPolicyKnowledge(),
      this.loadFAQKnowledge(),
      this.loadRecipeKnowledge(),
    ]);

    // Generate embeddings for semantic search
    await this.generateEmbeddings();

    this.initialized = true;
    console.log(`✅ Knowledge base initialized with ${this.documents.size} documents`);
  }

  // Load product information
  private async loadProductKnowledge() {
    try {
      // Fetch all products from API
      const response = await fetch('/api/products');
      const data = await response.json();

      if (data.products) {
        for (const product of data.products) {
          const doc: KnowledgeDocument = {
            id: `product_${product.id}`,
            type: 'product',
            title: product.name,
            content: this.formatProductContent(product),
            metadata: {
              vendorId: product.vendorId,
              vendorName: product.vendor,
              price: product.price,
              category: product.category,
              tags: product.tags,
              inStock: product.inStock,
              kosher: product.kosher,
              organic: product.organic,
              glutenFree: product.glutenFree,
            },
            lastUpdated: new Date(),
          };
          this.documents.set(doc.id, doc);
        }
      }
    } catch (error) {
      console.error('Error loading products:', error);
    }
  }

