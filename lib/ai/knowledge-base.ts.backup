  // Format product content for knowledge base
  private formatProductContent(product: any): string {
    return `${product.name} by ${product.vendor}
    
    Price: ₪${product.price}
    Category: ${product.category || 'General'}
    
    Description: ${product.description || 'Delicious vegan product from KFAR Marketplace'}
    
    Dietary Info:
    - 100% Vegan ✓
    ${product.kosher ? '- Kosher Certified ⓚ' : ''}
    ${product.organic ? '- Organic 🌱' : ''}
    ${product.glutenFree ? '- Gluten-Free' : ''}
    ${product.sugarFree ? '- Sugar-Free' : ''}
    
    ${product.ingredients ? `Ingredients: ${product.ingredients}` : ''}
    ${product.allergens ? `Allergens: ${product.allergens}` : ''}
    
    Vendor: ${product.vendor} - ${this.getVendorDescription(product.vendorId)}`;
  }

  // Get vendor description helper
  private getVendorDescription(vendorId: string): string {
    const descriptions: Record<string, string> = {
      'teva-deli': 'Israeli vegan deli with meat alternatives',
      'people-store': 'Community market with organic groceries',
      'queens-cuisine': 'Plant-based catering and prepared meals',
      'gahn-delight': 'Artisanal vegan ice cream',
      'garden-of-light': 'Fresh salads and raw foods',
      'vop-shop': 'Community merchandise and cultural items',
    };
    return descriptions[vendorId] || 'KFAR Marketplace vendor';
  }

  // Generate embeddings for semantic search
  private async generateEmbeddings() {
    try {
      const documents = Array.from(this.documents.values());
      const texts = documents.map(doc => `${doc.title}\n${doc.content}`);
      
      // Generate embeddings in batches
      const batchSize = 100;
      for (let i = 0; i < texts.length; i += batchSize) {
        const batch = texts.slice(i, i + batchSize);
        const { embeddings } = await embedMany({
          model: aiModels.default,
          values: batch,
        });
        
        // Store embeddings
        embeddings.forEach((embedding, index) => {
          const doc = documents[i + index];
          this.embeddings.set(doc.id, embedding);
        });
      }
    } catch (error) {
      console.error('Error generating embeddings:', error);
    }
  }

  // Search knowledge base with semantic similarity
  async search(query: string, options?: {
    type?: KnowledgeDocument['type'];
    limit?: number;
    threshold?: number;
  }): Promise<KnowledgeDocument[]> {
    const { type, limit = 5, threshold = 0.7 } = options || {};

    try {
      // Generate embedding for query
      const { embedding: queryEmbedding } = await embed({
        model: aiModels.default,
        value: query,
      });

      // Calculate similarities
      const similarities: Array<{ doc: KnowledgeDocument; score: number }> = [];
      
      for (const [docId, doc] of this.documents) {
        if (type && doc.type !== type) continue;
        
        const docEmbedding = this.embeddings.get(docId);
        if (!docEmbedding) continue;
        
        // Cosine similarity
        const score = this.cosineSimilarity(queryEmbedding, docEmbedding);
        if (score >= threshold) {
          similarities.push({ doc, score });
        }
      }

      // Sort by similarity and return top results
      return similarities
        .sort((a, b) => b.score - a.score)
        .slice(0, limit)
        .map(({ doc }) => doc);
    } catch (error) {
      console.error('Search error:', error);
      // Fallback to keyword search
      return this.keywordSearch(query, { type, limit });
    }
  }

  // Fallback keyword search
  private keywordSearch(query: string, options?: {
    type?: KnowledgeDocument['type'];
    limit?: number;
  }): KnowledgeDocument[] {
    const { type, limit = 5 } = options || {};
    const queryLower = query.toLowerCase();
    const results: Array<{ doc: KnowledgeDocument; score: number }> = [];

    for (const doc of this.documents.values()) {
      if (type && doc.type !== type) continue;
      
      const titleScore = doc.title.toLowerCase().includes(queryLower) ? 2 : 0;
      const contentScore = doc.content.toLowerCase().includes(queryLower) ? 1 : 0;
      const score = titleScore + contentScore;
      
      if (score > 0) {
        results.push({ doc, score });
      }
    }

    return results
      .sort((a, b) => b.score - a.score)
      .slice(0, limit)
      .map(({ doc }) => doc);
  }

  // Calculate cosine similarity between vectors
  private cosineSimilarity(a: number[], b: number[]): number {
    let dotProduct = 0;
    let normA = 0;
    let normB = 0;
    
    for (let i = 0; i < a.length; i++) {
      dotProduct += a[i] * b[i];
      normA += a[i] * a[i];
      normB += b[i] * b[i];
    }
    
    return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));
  }

  // Generate unique ID from text
  private generateId(text: string): string {
    return text
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  }

  // Get context for chat
  async getContextForQuery(query: string): Promise<string> {
    const relevantDocs = await this.search(query, { limit: 3 });
    
    if (relevantDocs.length === 0) {
      return 'No specific context found.';
    }

    return relevantDocs
      .map(doc => `${doc.title}:\n${doc.content}`)
      .join('\n\n---\n\n');
  }

  // Get all documents by type
  getDocumentsByType(type: KnowledgeDocument['type']): KnowledgeDocument[] {
    return Array.from(this.documents.values()).filter(doc => doc.type === type);
  }

  // Get document by ID
  getDocument(id: string): KnowledgeDocument | undefined {
    return this.documents.get(id);
  }

  // Update document
  async updateDocument(id: string, updates: Partial<KnowledgeDocument>) {
    const doc = this.documents.get(id);
    if (!doc) return;

    const updated = {
      ...doc,
      ...updates,
      lastUpdated: new Date(),
    };
    
    this.documents.set(id, updated);
    
    // Regenerate embedding if content changed
    if (updates.content || updates.title) {
      const { embedding } = await embed({
        model: aiModels.default,
        value: `${updated.title}\n${updated.content}`,
      });
      this.embeddings.set(id, embedding);
    }
  }
}

// Singleton instance
export const kfarKnowledgeBase = new KFARKnowledgeBase();

// Initialize on first import
if (typeof window !== 'undefined') {
  kfarKnowledgeBase.initialize().catch(console.error);
}